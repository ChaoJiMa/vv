ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_MODEL=glm-5.3-flash

# zhipu、deepseek 或 openai；不自动跨厂商转发，未设置时沿用智谱
REPORT_MODEL_PROVIDER=zhipu
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
# chatgpt：本应用独立浏览器账号授权，无需API Key；api_key：按API项目额度计费
OPENAI_AUTH_MODE=chatgpt
OPENAI_MODEL=gpt-6.1-sol
# 可选OpenAI兼容网关基础地址；留空使用官方地址，网关须支持 /responses
OPENAI_BASE_URL=
# 可选：仅OpenAI模型及其账号授权HTTP使用的网络代理；不改变官方地址，不继承系统代理
# 示例 http://127.0.0.1:7890；端口以本机实际设置为准，不在地址中填写代理密码
OPENAI_PROXY_URL=

# off：完全本地；on：AI理解分析，通过检查的问题和统计值发送至所选厂商
# 身份/凭据/明细留在本地；勿在问题中粘贴个人信息，检查不能保证完全匿名化
REPORT_EXTERNAL_MODEL=off

# demo：本地演示；api：登录后读取当前用户报告
REPORT_DATA_SOURCE=demo
# 测试网关地址，与测试 H5 的 VITE_API 相同
REPORT_API_BASE_URL=https://testopen.beironsign.com
# test：测试网关自动获取通用验证码并登录；sms：使用已有的短信验证码登录
REPORT_LOGIN_MODE=test
REPORT_LOGIN_MOBILE=
REPORT_TEST_USER_NAME=
# sms 模式可留空，启动时安全输入；test 模式不使用此项
REPORT_LOGIN_SMS_CODE=
# 可选：复用已有 token；留空则自动登录，获取的 token 不写入文件
REPORT_USER_TOKEN=
